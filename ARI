#定义计算 ARI 的函数

calc_ari_for_one_tool <- function(tool_name, cluster_file, truth_df) {
  
  message("正在处理：", tool_name)
  
  
  #读取工具输出的 CSV
  
  cluster_df <- read.csv(
    cluster_file,
    stringsAsFactors = FALSE,
    check.names = FALSE
  )
  
  
  #保留 cell 和 cluster
  
  cluster_df <- cluster_df[, c("cell", "cluster")]
  
  #修改格式
  cluster_df$cell <- as.character(cluster_df$cell)
  truth_df$cell <- as.character(truth_df$cell)
  
  n_dup_cluster <- sum(duplicated(cluster_df$cell))
  
  #合并 ground truth 和 cluster
  
  merged_df <- merge(
    truth_df,
    cluster_df,
    by = "cell",
    all = FALSE
  )
  
  #处理缺失值
  
  n_before_na_filter <- nrow(merged_df)
  
  filtered_df <- merged_df[
    !is.na(merged_df$author_cell_type) &
      !is.na(merged_df$cluster) &
      merged_df$author_cell_type != "" &
      merged_df$cluster != "",
  ]
  
  n_after_na_filter <- nrow(filtered_df)
  n_removed_na <- n_before_na_filter - n_after_na_filter
  
  #计算 ARI
  
  if (nrow(filtered_df) == 0) {
    ari_value <- NA
  } else {
    ari_value <- adjustedRandIndex(
      as.factor(filtered_df$cluster),
      as.factor(filtered_df$author_cell_type)
    )
  }
  
  result <- data.frame(
    tool = tool_name,
    file = basename(cluster_file),
    n_truth_cells = nrow(truth_df),
    n_cluster_cells = nrow(cluster_df),
    n_matched_cells = nrow(merged_df),
    n_used_cells_after_removing_NA = nrow(filtered_df),
    n_removed_due_to_NA_or_empty = n_removed_na,
    n_unmatched_truth_cells = nrow(truth_df) - nrow(merged_df),
    n_unmatched_cluster_cells = nrow(cluster_df) - nrow(merged_df),
    n_truth_cell_types_used = length(unique(filtered_df$author_cell_type)),
    n_clusters_used = length(unique(filtered_df$cluster)),
    ARI = ari_value,
    stringsAsFactors = FALSE
  )
  
  return(result)
}

#计算 ARI

ari_results <- do.call(
  rbind,
  mapply(
    FUN = calc_ari_for_one_tool,
    tool_name = names(tool_files),
    cluster_file = tool_files,
    MoreArgs = list(truth_df = truth_df),
    SIMPLIFY = FALSE
  )
)
ari_results <- ari_results[order(-ari_results$ARI), ]

print(ari_results)

output_file <- file.path(base_dir, "ARI_results_three_tools.csv")

