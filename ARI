#查看每个工具 cluster vs author_cell_type 的表
make_cluster_truth_table <- function(cluster_file, truth_df) {
  
  cluster_df <- read.csv(
    cluster_file,
    stringsAsFactors = FALSE,
    check.names = FALSE
  )
  
  cluster_df <- cluster_df[, c("cell", "cluster")]
  cluster_df$cell <- as.character(cluster_df$cell)
  truth_df$cell <- as.character(truth_df$cell)
  
  cluster_df <- cluster_df[!duplicated(cluster_df$cell), ]
  
  merged_df <- merge(
    truth_df,
    cluster_df,
    by = "cell",
    all = FALSE
  )
  
  merged_df <- merged_df[
    !is.na(merged_df$author_cell_type) &
      !is.na(merged_df$cluster) &
      merged_df$author_cell_type != "" &
      merged_df$cluster != "",
  ]
  
  tab <- table(
    cluster = merged_df$cluster,
    author_cell_type = merged_df$author_cell_type
  )
  
  return(tab)
}

