#定义 Batch sensitivity 计算函数
calc_batch_sensitivity <- function(tool_name, cluster_file, truth_df, simulation_keep = NULL) {
  
  cat("\nProcessing:", tool_name, "\n")
  cat("File:", cluster_file, "\n")
  
  cluster_df <- read.csv(
    cluster_file,
    stringsAsFactors = FALSE,
    check.names = FALSE
  )
  
  if (!all(c("cell", "cluster") %in% colnames(cluster_df))) {
    stop(
      paste0()
      )
    )
  }
  
  cluster_df <- cluster_df[, c("cell", "cluster")]
  
  cluster_df$cell <- as.character(cluster_df$cell)
  cluster_df$cluster <- as.character(cluster_df$cluster)
  
  cluster_df <- cluster_df[
    !is.na(cluster_df$cell) &
      !is.na(cluster_df$cluster) &
      cluster_df$cell != "" &
      cluster_df$cluster != "",
  ]
  
  cluster_df <- cluster_df[!duplicated(cluster_df$cell), ]
  
  #合并 ground truth 和 cluster
  
  merged_df <- merge(
    truth_df,
    cluster_df,
    by = "cell",
    all = FALSE
  )
  
  if (nrow(merged_df) == 0) {
    stop(paste0())
  }
  
  #构建组合标签
  merged_df$celltype_condition <- paste(
    merged_df$cell_type,
    merged_df$condition,
    sep = "_"
  )
  
  merged_df$celltype_condition_batch <- paste(
    merged_df$cell_type,
    merged_df$condition,
    merged_df$batch,
    sep = "_"
  )
  
  # 计算两个 ARI
  ari_celltype_condition <- adjustedRandIndex(
    as.factor(merged_df$cluster),
    as.factor(merged_df$celltype_condition)
  )
  
  ari_celltype_condition_batch <- adjustedRandIndex(
    as.factor(merged_df$cluster),
    as.factor(merged_df$celltype_condition_batch)
  )
  
  batch_sensitivity <- ari_celltype_condition_batch - ari_celltype_condition
  
  # 输出结果
  result <- data.frame(
    tool = tool_name,
    file = basename(cluster_file),
    n_truth_cells = nrow(truth_df),
    n_cluster_cells = nrow(cluster_df),
    n_matched_cells = nrow(merged_df),
    n_clusters = length(unique(merged_df$cluster)),
    n_celltype_condition_groups = length(unique(merged_df$celltype_condition)),
    n_celltype_condition_batch_groups = length(unique(merged_df$celltype_condition_batch)),
    ARI_cluster_celltype_condition = ari_celltype_condition,
    ARI_cluster_celltype_condition_batch = ari_celltype_condition_batch,
    Batch_sensitivity = batch_sensitivity,
    stringsAsFactors = FALSE
  )
  
  return(result)
}

#对三个工具计算
batch_sensitivity_results <- do.call(
