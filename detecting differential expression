# TOOL OVERALL RANKING

tool_ranking <- score_df %>%
  mutate(
    precision_for_ranking = ifelse(is.na(precision), 0, precision),
    recall_for_ranking = ifelse(is.na(recall), 0, recall),
    f1_for_ranking = ifelse(is.na(f1), 0, f1)
  ) %>%
  group_by(tool, mode) %>%
  summarise(
    mean_precision = mean(precision_for_ranking, na.rm = TRUE),
    mean_recall = mean(recall_for_ranking, na.rm = TRUE),
    mean_f1 = mean(f1_for_ranking, na.rm = TRUE),
    total_true_positive = sum(true_positive, na.rm = TRUE),
    total_false_positive = sum(false_positive, na.rm = TRUE),
    total_false_negative = sum(false_negative, na.rm = TRUE),
    total_predicted = sum(n_predicted, na.rm = TRUE),
    total_ground_truth = sum(n_ground_truth, na.rm = TRUE),
    .groups = "drop"
  ) %>%
  arrange(
    mode,
    desc(mean_f1),
    desc(mean_recall),
    desc(mean_precision),
    desc(total_true_positive)
  )

