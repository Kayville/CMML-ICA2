# HELPER FUNCTIONS

clean_gene <- function(x) {
  x <- as.character(x)
  x <- trimws(x)

  ## Remove accidental version suffix like gene_123.1 or ENSG... .1
  x <- gsub("\\.\\d+$", "", x)

  ## Convert to lower case
  x <- tolower(x)

  ## Standardize simulated gene IDs:
  ## gene-2278 -> gene_2278
  ## gene.2278 -> gene_2278
  x <- gsub("^gene[-\\.]", "gene_", x)

  x
}

score_precision_recall_f1 <- function(predicted_genes, ground_truth_genes) {
  pred <- unique(clean_gene(predicted_genes))
  gt <- unique(clean_gene(ground_truth_genes))

  pred <- pred[!is.na(pred) & pred != ""]
  gt <- gt[!is.na(gt) & gt != ""]

  tp <- length(intersect(pred, gt))
  fp <- length(setdiff(pred, gt))
  fn <- length(setdiff(gt, pred))

  precision <- ifelse(tp + fp == 0, NA_real_, tp / (tp + fp))
  recall <- ifelse(tp + fn == 0, NA_real_, tp / (tp + fn))

  f1 <- ifelse(
    is.na(precision) | is.na(recall) | precision + recall == 0,
    NA_real_,
    2 * precision * recall / (precision + recall)
  )

  tibble(
    n_ground_truth = length(gt),
    n_predicted = length(pred),
    true_positive = tp,
    false_positive = fp,
    false_negative = fn,
    precision = precision,
    recall = recall,
    f1 = f1
  )
}

read_tool_csv <- function(file_path) {
  if (!file.exists(file_path)) {
    stop("File not found: ", file_path)
  }

  df <- readr::read_csv(file_path, show_col_types = FALSE)

  if (nrow(df) == 0) {
    stop("CSV file is empty: ", file_path)
  }

  df
}

check_required_columns <- function(df, cfg, tool_name) {
  required_cols <- c(cfg$gene_col, cfg$cluster_col)

  missing_required <- setdiff(required_cols, colnames(df))

  if (length(missing_required) > 0) {
    stop(
      tool_name,
      " missing required columns: ",
      paste(missing_required, collapse = ", "),
      "\nAvailable columns are:\n",
      paste(colnames(df), collapse = ", ")
    )
  }

  if (!(cfg$padj_col %in% colnames(df))) {
    warning(
      tool_name,
      " does not have padj/FDR/q-value column: ",
      cfg$padj_col,
      ". padj mode will return no genes for this tool."
    )
  }

  if (!(cfg$score_col %in% colnames(df))) {
    warning(
      tool_name,
      " does not have score/logFC column: ",
      cfg$score_col,
      ". Ranking will use q-value only or original row order."
    )
  }
}

prepare_tool_table <- function(df, cfg) {
  df2 <- df %>%
    mutate(
      gene_raw = as.character(.data[[cfg$gene_col]]),
      gene_eval = clean_gene(gene_raw),
      tool_cluster_eval = as.character(.data[[cfg$cluster_col]])
    )

  if (cfg$padj_col %in% colnames(df2)) {
    df2 <- df2 %>%
      mutate(padj_eval = suppressWarnings(as.numeric(.data[[cfg$padj_col]])))
  } else {
    df2 <- df2 %>%
      mutate(padj_eval = NA_real_)
  }

  if (cfg$score_col %in% colnames(df2)) {
    df2 <- df2 %>%
      mutate(score_eval = suppressWarnings(as.numeric(.data[[cfg$score_col]])))
  } else {
    df2 <- df2 %>%
      mutate(score_eval = NA_real_)
  }

  cluster_map <- cfg$cluster_map %>%
    mutate(
      tool_cluster = as.character(tool_cluster),
      truth_celltype = as.character(truth_celltype)
    )

  df2 <- df2 %>%
    left_join(
      cluster_map,
      by = c("tool_cluster_eval" = "tool_cluster")
    )

  df2
}

select_predicted_genes <- function(df_ct, mode, gt_n) {
  if (nrow(df_ct) == 0) {
    return(tibble())
  }

  if (mode == "padj") {

    df_pred <- df_ct %>%
      filter(
        !is.na(padj_eval),
        padj_eval < padj_threshold
      ) %>%
      arrange(
        padj_eval,
        desc(score_eval)
      )

  } else if (mode == "topN") {

    df_pred <- df_ct %>%
      arrange(
        ifelse(is.na(padj_eval), Inf, padj_eval),
        desc(score_eval)
      ) %>%
      slice_head(n = gt_n)

  } else {
    stop("Unknown evaluation mode: ", mode)
  }

  df_pred
}


#MAIN ANALYSIS

modes_to_run <- switch(
  evaluation_mode,
  padj = "padj",
  topN = "topN",
  both = c("padj", "topN"),
  stop("evaluation_mode must be 'padj', 'topN', or 'both'.")
)

all_scores <- list()
all_predicted_gene_tables <- list()
all_unmapped_cluster_tables <- list()
all_column_check_tables <- list()

for (tool_name in names(tool_configs)) {

  message("\n==============================")
  message("Processing: ", tool_name)
  message("==============================")

  cfg <- tool_configs[[tool_name]]

  raw_df <- read_tool_csv(cfg$file)

  check_required_columns(raw_df, cfg, tool_name)

  message("Input file: ", cfg$file)
  message("Gene column: ", cfg$gene_col)
  message("Cluster column: ", cfg$cluster_col)
  message("Padj/FDR/q-value column: ", cfg$padj_col)
  message("Score/logFC column: ", cfg$score_col)

  column_check <- tibble(
    tool = tool_name,
    input_file = cfg$file,
    gene_col = cfg$gene_col,
    gene_col_found = cfg$gene_col %in% colnames(raw_df),
    cluster_col = cfg$cluster_col,
    cluster_col_found = cfg$cluster_col %in% colnames(raw_df),
    padj_col = cfg$padj_col,
    padj_col_found = cfg$padj_col %in% colnames(raw_df),
    score_col = cfg$score_col,
    score_col_found = cfg$score_col %in% colnames(raw_df),
    available_columns = paste(colnames(raw_df), collapse = "; ")
  )

  all_column_check_tables[[tool_name]] <- column_check

  df <- prepare_tool_table(raw_df, cfg)

  unmapped_clusters <- setdiff(
    unique(df$tool_cluster_eval),
    as.character(cfg$cluster_map$tool_cluster)
  )

  unmapped_cluster_table <- tibble(
    tool = tool_name,
    unmapped_cluster = unmapped_clusters
  )

  all_unmapped_cluster_tables[[tool_name]] <- unmapped_cluster_table

  if (length(unmapped_clusters) > 0) {
    warning(
      tool_name,
      " has unmapped clusters: ",
      paste(unmapped_clusters, collapse = ", ")
    )
  }

  message("Mapped cell type distribution:")
  print(table(df$truth_celltype, useNA = "ifany"))

  for (ct in target_celltypes) {

    df_ct <- df %>%
      filter(truth_celltype == ct)

    if (nrow(df_ct) == 0) {
      warning(tool_name, " has no rows mapped to ", ct)
    }

    gt_n <- length(ground_truth_markers[[ct]])

    for (mode in modes_to_run) {

      df_pred <- select_predicted_genes(
        df_ct = df_ct,
        mode = mode,
        gt_n = gt_n
      )

      predicted_genes <- unique(df_pred$gene_eval)

      score <- score_precision_recall_f1(
        predicted_genes = predicted_genes,
        ground_truth_genes = ground_truth_markers[[ct]]
      ) %>%
        mutate(
          tool = tool_name,
          celltype = ct,
          mode = mode,
          input_file = cfg$file,
          gene_col_used = cfg$gene_col,
          cluster_col_used = cfg$cluster_col,
          padj_col_used = cfg$padj_col,
          score_col_used = cfg$score_col,
          .before = 1
        )

      all_scores[[paste(tool_name, ct, mode, sep = "__")]] <- score

      pred_table <- df_pred %>%
        transmute(
          tool = tool_name,
          celltype = ct,
          mode = mode,
          predicted_gene_raw = gene_raw,
          predicted_gene_eval = gene_eval,
          tool_cluster = tool_cluster_eval,
          truth_celltype = truth_celltype,
          padj = padj_eval,
          score = score_eval,
          is_ground_truth_hit = gene_eval %in% clean_gene(ground_truth_markers[[ct]])
        ) %>%
        distinct()

      all_predicted_gene_tables[[paste(tool_name, ct, mode, sep = "__")]] <- pred_table
    }
  }
}


