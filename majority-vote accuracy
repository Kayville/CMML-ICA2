print(table(truth_df$author_cell_type))

############################################################
## 4. 定义 majority-vote accuracy 函数
############################################################

calc_majority_vote_accuracy <- function(tool_name, cluster_file, truth_df, simulation_keep = NULL) {
  
  cat("\nProcessing:", tool_name, "\n")
  cat("File:", cluster_file, "\n")
  
  cluster_df <- read.csv(
    cluster_file,
    stringsAsFactors = FALSE,
    check.names = FALSE
  )
  
  if (!all(c("cell", "cluster") %in% colnames(cluster_df))) {
    stop(
      paste0(
        tool_name,
        " 的 CSV 缺少 cell 或 cluster 列。当前列名是：",
        paste(colnames(cluster_df), collapse = ", ")
      )
    )
  }
  
  ##########################################################
  ## 如果有 simulation 列，并且指定了 simulation_keep，就筛选
  ##########################################################
  
  if (!is.null(simulation_keep)) {
    
    if (!"simulation" %in% colnames(cluster_df)) {
      stop(paste0(tool_name, " 没有 simulation 列，不能筛选 simulation。"))
    }
    
    cluster_df <- cluster_df[cluster_df$simulation == simulation_keep, ]
  }
  
  cluster_df <- cluster_df[, c("cell", "cluster")]
  
  cluster_df$cell <- as.character(cluster_df$cell)
  cluster_df$cluster <- as.character(cluster_df$cluster)
  
  cluster_df <- cluster_df[
    !is.na(cluster_df$cell) &
      !is.na(cluster_df$cluster) &
      cluster_df$cell != "" &
      cluster_df$cluster != "",
  ]
  
  cluster_df <- cluster_df[!duplicated(cluster_df$cell), ]
  
  ##########################################################
  ## 按 cell 合并
  ##########################################################
  
  merged_df <- merge(
    truth_df,
    cluster_df,
    by = "cell",
    all = FALSE
  )
  
  if (nrow(merged_df) == 0) {
    stop(paste0(tool_name, " 没有和 ground truth 匹配上的 cell。"))
  }
  
  ##########################################################
  ## 每个 cluster 通过 majority vote 映射到真实 cell type
  ##########################################################
  
  cluster_mapping <- merged_df %>%
    count(cluster, author_cell_type, name = "n") %>%
    group_by(cluster) %>%
    slice_max(order_by = n, n = 1, with_ties = FALSE) %>%
    ungroup() %>%
    rename(predicted_cell_type = author_cell_type)
  
  ##########################################################
  ## 把预测标签合并回每个 cell
  ##########################################################
  
  pred_df <- merged_df %>%
    left_join(cluster_mapping[, c("cluster", "predicted_cell_type")], by = "cluster") %>%
    mutate(correct = author_cell_type == predicted_cell_type)
  
  majority_vote_accuracy <- mean(pred_df$correct)
  
  ##########################################################
  ## 输出 summary
  ##########################################################
  
  result <- data.frame(
    tool = tool_name,
    file = basename(cluster_file),
    n_truth_cells = nrow(truth_df),
    n_cluster_cells = nrow(cluster_df),
    n_matched_cells = nrow(merged_df),
    n_clusters = length(unique(merged_df$cluster)),
    n_truth_cell_types = length(unique(merged_df$author_cell_type)),
    majority_vote_accuracy = majority_vote_accuracy,
    stringsAsFactors = FALSE
  )
  
  return(
    list(
      summary = result,
      cluster_mapping = cluster_mapping,
      prediction_detail = pred_df
    )
  )
}

############################################################
## 5. 对三个工具计算 majority-vote accuracy
############################################################

mv_results_list <- lapply(names(tool_files), function(tool_name) {
  calc_majority_vote_accuracy(
    tool_name = tool_name,
    cluster_file = tool_files[[tool_name]],
    truth_df = truth_df,
    simulation_keep = simulation_keep
  )
})

names(mv_results_list) <- names(tool_files)

############################################################
## 6. 汇总三个工具的 majority-vote accuracy
############################################################

mv_summary <- do.call(
  rbind,
  lapply(mv_results_list, function(x) x$summary)
)

mv_summary$majority_vote_accuracy <- sprintf(
  "%.10f",
  as.numeric(mv_summary$majority_vote_accuracy)
)

print(mv_summary)

############################################################
## 7. 保存结果
############################################################

summary_file <- file.path(
  base_dir,
  paste0(output_prefix, "_majority_vote_accuracy_summary.csv")
)

write.csv(
  mv_summary,
  summary_file,
  row.names = FALSE
)

cat("\nMajority-vote accuracy summary saved to:\n")
cat(summary_file, "\n")

############################################################
## 8. 保存每个工具的 cluster -> majority cell type 映射表
############################################################

for (tool_name in names(mv_results_list)) {
  
  mapping_file <- file.path(
    base_dir,
    paste0(output_prefix, "_", tool_name, "_cluster_majority_mapping.csv")
  )
  
  write.csv(
    mv_results_list[[tool_name]]$cluster_mapping,
    mapping_file,
    row.names = FALSE
  )
}

cat("\nCluster majority mappings saved.\n")
