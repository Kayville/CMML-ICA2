# 单次模拟
run_one_scdesign3 <- function(
    sce,
    mu_formula,
    dataset_name,
    replicate_id,
    seed
) {
  set.seed(seed)

  cat("\n====================================================\n")
  cat("Running ", dataset_name, "_rep", replicate_id, "\n", sep = "")
  cat("mu_formula = ", mu_formula, "\n", sep = "")
  cat("Reference cell type table:\n")
  print(table(colData(sce)$author_cell_type))

  my_simu <- do.call(
    scdesign3,
    c(
      list(
        sce = sce,
        mu_formula = mu_formula
      ),
      common_args
    )
  )

  if (is.null(my_simu$new_count)) {
    stop(dataset_name, "_rep", replicate_id, ": my_simu$new_count is NULL.")
  }

  if (is.null(my_simu$new_covariate)) {
    stop(dataset_name, "_rep", replicate_id, ": my_simu$new_covariate is NULL. 请确认 ncell != ncol(sce)。")
  }

  core_out <- list(
    new_count = my_simu$new_count,
    new_covariate = my_simu$new_covariate
  )

  core_file <- file.path(
    outdir,
    paste0(dataset_name, "_rep", replicate_id, "_new_count_new_covariate.rds")
  )

  full_file <- file.path(
    outdir,
    paste0(dataset_name, "_rep", replicate_id, "_full_my_simu.rds")
  )

  saveRDS(core_out, core_file)
  saveRDS(my_simu, full_file)

  cat("Saved core output to:\n", core_file, "\n", sep = "")
  cat("Saved full my_simu to:\n", full_file, "\n", sep = "")

  cat("Simulated count dim:\n")
  print(dim(my_simu$new_count))

  cat("Simulated author_cell_type table:\n")
  print(table(my_simu$new_covariate$author_cell_type))

  invisible(my_simu)
}


# 三种 dataset，每种两个模拟集
