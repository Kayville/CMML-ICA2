# 汇总保存
summary_table <- do.call(
  rbind,
  lapply(names(all_simu), function(nm) {
    covar <- all_simu[[nm]]$new_covariate
    tab <- table(covar$author_cell_type)

    data.frame(
      simulation = nm,
      n_genes = nrow(all_simu[[nm]]$new_count),
      n_cells = ncol(all_simu[[nm]]$new_count),
      dExN = ifelse("dExN" %in% names(tab), as.integer(tab["dExN"]), 0L),
      RG   = ifelse("RG"   %in% names(tab), as.integer(tab["RG"]), 0L),
      InhN = ifelse("InhN" %in% names(tab), as.integer(tab["InhN"]), 0L)
    )
  })
)

write.csv(
