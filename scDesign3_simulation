# 按目标比例重采样 reference SCE
make_reference_by_celltype <- function(
    sce,
    target_n_by_type,
    celltype_col = "author_cell_type",
    seed = 1
) {
  set.seed(seed)

  ct <- as.character(colData(sce)[[celltype_col]])
  target_types <- names(target_n_by_type)

  if (!all(target_types %in% unique(ct))) {
    stop()
    )
  }

  sampled_idx <- unlist(lapply(target_types, function(x) {
    idx <- which(ct == x)
    sample(idx, size = target_n_by_type[[x]], replace = TRUE)
  }), use.names = FALSE)

  sampled_idx <- sample(sampled_idx, length(sampled_idx), replace = FALSE)

  sce_new <- sce[, sampled_idx]
  colnames(sce_new) <- paste0("ref_", seq_len(ncol(sce_new)))

  colData(sce_new)$author_cell_type <- droplevels(factor(colData(sce_new)$author_cell_type))
  colData(sce_new)$condition <- droplevels(factor(colData(sce_new)$condition))
  colData(sce_new)$batch <- droplevels(factor(colData(sce_new)$batch))

  sce_new
}

