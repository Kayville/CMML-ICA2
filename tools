standardize_counts <- function(counts) {
  if (is.data.frame(counts)) {
    counts <- as.matrix(counts)
  }

  if (!inherits(counts, "dgCMatrix")) {
    counts <- Matrix::Matrix(as.matrix(counts), sparse = TRUE)
  }

  if (is.null(rownames(counts))) {
    rownames(counts) <- paste0("gene_", seq_len(nrow(counts)))
  }

  if (is.null(colnames(counts))) {
    colnames(counts) <- paste0("cell_", seq_len(ncol(counts)))
  }

  rownames(counts) <- make.unique(as.character(rownames(counts)))
  colnames(counts) <- make.unique(as.character(colnames(counts)))

  counts
}


align_covariate_to_cells <- function(cov, cell_names) {
  cov <- as.data.frame(cov)

  if (!is.null(rownames(cov)) && all(cell_names %in% rownames(cov))) {
    cov <- cov[cell_names, , drop = FALSE]
    return(cov)
  }

  possible_cell_cols <- c(
    "cell",
    "cell_id",
    "cellID",
    "barcode",
    "Cell",
    "CellID",
    "cell_name",
    "cell_names"
  )

  matched_col <- possible_cell_cols[possible_cell_cols %in% colnames(cov)]

  if (length(matched_col) > 0) {
    cell_col <- matched_col[1]
    rownames(cov) <- as.character(cov[[cell_col]])

    if (all(cell_names %in% rownames(cov))) {
      cov <- cov[cell_names, , drop = FALSE]
      return(cov)
    }
  }

  if (nrow(cov) == length(cell_names)) {
    rownames(cov) <- cell_names
    return(cov)
  }

  stop(
    "Could not align new_covariate to count matrix columns. ",
    "Please check whether rows of new_covariate correspond to cells."
  )
}


make_safe_metadata <- function(meta) {
  meta <- as.data.frame(meta)

  for (nm in colnames(meta)) {
    if (is.matrix(meta[[nm]]) || is.list(meta[[nm]])) {
      meta[[nm]] <- as.character(meta[[nm]])
    }
  }

  meta
}


save_session_info <- function(outdir, sim_label) {
