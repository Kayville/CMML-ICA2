############################################################
## 5. Seurat workflow
############################################################

cat("\n==============================\n")
cat("Running Seurat workflow...\n")
cat("==============================\n")

seu <- CreateSeuratObject(
  counts = sim_counts,
  meta.data = cell_metadata,
  project = paste0("scDesign3_simulation_", sim_label)
)

seu <- NormalizeData(seu)

seu <- FindVariableFeatures(
  seu,
  selection.method = "vst",
  nfeatures = min(2000, nrow(seu))
)

seu <- ScaleData(seu)

n_pcs_seurat <- min(
  30,
  ncol(seu) - 1,
  length(VariableFeatures(seu))
)

if (n_pcs_seurat < 2) {
  stop("Too few cells or variable genes for Seurat PCA.")
}

seu <- RunPCA(
  seu,
  features = VariableFeatures(seu),
  npcs = n_pcs_seurat
)

dims_use_seurat <- 1:min(20, n_pcs_seurat)

seu <- FindNeighbors(seu, dims = dims_use_seurat)

seu <- FindClusters(
  seu,
  resolution = 0.5
)

seu <- RunUMAP(
  seu,
  dims = dims_use_seurat
)

seurat_clusters <- data.frame(
  cell = colnames(seu),
  cluster = as.character(Idents(seu)),
  simulation = sim_label,
  stringsAsFactors = FALSE
)

seurat_umap <- as.data.frame(Embeddings(seu, reduction = "umap"))
seurat_umap$cell <- rownames(seurat_umap)
seurat_umap$simulation <- sim_label

## 统一列名
if (all(c("umap_1", "umap_2") %in% colnames(seurat_umap))) {
  seurat_umap_out <- data.frame(
    cell = seurat_umap$cell,
    UMAP_1 = seurat_umap$umap_1,
    UMAP_2 = seurat_umap$umap_2,
    simulation = seurat_umap$simulation
  )
} else {
  seurat_umap_out <- seurat_umap
  colnames(seurat_umap_out)[1:2] <- c("UMAP_1", "UMAP_2")
}

seurat_markers <- FindAllMarkers(
  seu,
  only.pos = TRUE,
  min.pct = 0.25,
  logfc.threshold = 0.25
)

seurat_markers$simulation <- sim_label

safe_write_csv(
  seurat_clusters,
  file.path(outdir, paste0("seurat_clusters_", sim_label, ".csv"))
)

safe_write_csv(
  seurat_umap_out,
  file.path(outdir, paste0("seurat_umap_", sim_label, ".csv"))
)

safe_write_csv(
  seurat_markers,
  file.path(outdir, paste0("seurat_markers_", sim_label, ".csv"))
)

saveRDS(
