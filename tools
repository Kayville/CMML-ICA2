  file.path(outdir, paste0("seurat_object_", sim_label, ".rds"))
)

cat("Seurat workflow finished.\n")


############################################################
## 6. scran / scater Bioconductor workflow
############################################################

cat("\n==============================\n")
cat("Running scran/scater workflow...\n")
cat("==============================\n")

## 重新创建 sce，避免之前被覆盖成 factor
sce <- SingleCellExperiment(
  assays = list(counts = sim_counts),
  colData = cell_metadata
)

sce <- addPerCellQC(sce)
sce <- logNormCounts(sce)

dec <- modelGeneVar(sce)

n_hvg <- min(2000, nrow(sce))
hvg <- getTopHVGs(dec, n = n_hvg)

n_pcs_scran <- min(
  30,
  ncol(sce) - 1,
  length(hvg)
)

if (n_pcs_scran < 2) {
  stop("Too few cells or HVGs for scran/scater PCA.")
}

sce <- runPCA(
  sce,
  subset_row = hvg,
  ncomponents = n_pcs_scran
)

dims_use_scran <- 1:min(20, n_pcs_scran)

## 重点：clusterCells 的结果单独保存，不能覆盖 sce
scran_cluster_labels <- clusterCells(
  sce,
  use.dimred = "PCA",
  BLUSPARAM = NNGraphParam(
    k = 10,
    cluster.fun = "louvain"
  )
)

sce$cluster <- as.factor(scran_cluster_labels)

sce <- runUMAP(
  sce,
  dimred = "PCA",
  n_dimred = length(dims_use_scran)
)

scran_markers_list <- findMarkers(
  sce,
  groups = sce$cluster,
  direction = "up"
)

scran_markers_list <- findMarkers(
  sce,
  groups = sce$cluster,
  direction = "up"
)

scran_marker_list_df <- lapply(names(scran_markers_list), function(cl) {
  x <- as.data.frame(scran_markers_list[[cl]])
  x$gene <- rownames(x)
  x$cluster <- cl
  x$simulation <- sim_label
  x
})

all_marker_cols <- unique(unlist(lapply(scran_marker_list_df, colnames)))

scran_marker_list_df <- lapply(scran_marker_list_df, function(x) {
  missing_cols <- setdiff(all_marker_cols, colnames(x))

  if (length(missing_cols) > 0) {
    for (mc in missing_cols) {
      x[[mc]] <- NA
    }
  }

  x <- x[, all_marker_cols, drop = FALSE]
  x
})

scran_marker_df <- do.call(rbind, scran_marker_list_df)
rownames(scran_marker_df) <- NULL

scran_clusters <- data.frame(
  cell = colnames(sce),
  cluster = as.character(sce$cluster),
  simulation = sim_label,
  stringsAsFactors = FALSE
)

scran_umap <- as.data.frame(reducedDim(sce, "UMAP"))
colnames(scran_umap)[1:2] <- c("UMAP_1", "UMAP_2")
scran_umap$cell <- rownames(scran_umap)
scran_umap$simulation <- sim_label

scran_umap_out <- data.frame(
  cell = scran_umap$cell,
  UMAP_1 = scran_umap$UMAP_1,
  UMAP_2 = scran_umap$UMAP_2,
  simulation = scran_umap$simulation,
  stringsAsFactors = FALSE
)

safe_write_csv(
  scran_clusters,
  file.path(outdir, paste0("scran_scater_clusters_", sim_label, ".csv"))
)

safe_write_csv(
  scran_umap_out,
  file.path(outdir, paste0("scran_scater_umap_", sim_label, ".csv"))
)

safe_write_csv(
  scran_marker_df,
  file.path(outdir, paste0("scran_scater_markers_", sim_label, ".csv"))
)

saveRDS(
  sce,
  file.path(outdir, paste0("scran_scater_sce_", sim_label, ".rds"))
)

saveRDS(
  scran_markers_list,
  file.path(outdir, paste0("scran_scater_markers_list_", sim_label, ".rds"))
)

cat("scran/scater workflow finished.\n")

############################################################
## 7. Monocle3 workflow
############################################################

if (run_monocle3) {

  cat("\n==============================\n")
  cat("Running Monocle3 workflow...\n")
  cat("==============================\n")

  gene_metadata <- data.frame(
    gene_short_name = rownames(sim_counts),
    row.names = rownames(sim_counts),
    stringsAsFactors = FALSE
  )

  monocle_cell_metadata <- cell_metadata
  monocle_cell_metadata$cell <- rownames(monocle_cell_metadata)

  cds <- new_cell_data_set(
    expression_data = sim_counts,
    cell_metadata = monocle_cell_metadata,
    gene_metadata = gene_metadata
  )

  n_dim_monocle <- min(
    30,
    ncol(cds) - 1,
    nrow(cds)
  )

  if (n_dim_monocle < 2) {
    stop("Too few cells or genes for Monocle3 preprocessing.")
  }

  cds <- preprocess_cds(
    cds,
    num_dim = n_dim_monocle,
    method = "PCA"
  )

  cds <- reduce_dimension(
    cds,
    reduction_method = "UMAP"
  )

  cds <- cluster_cells(
    cds,
    reduction_method = "UMAP"
  )

  monocle_clusters <- data.frame(
    cell = colnames(cds),
    cluster = as.character(clusters(cds)),
    simulation = sim_label,
    stringsAsFactors = FALSE
  )

  monocle_umap <- as.data.frame(reducedDims(cds)$UMAP)
  colnames(monocle_umap)[1:2] <- c("UMAP_1", "UMAP_2")
  monocle_umap$cell <- rownames(monocle_umap)
  monocle_umap$simulation <- sim_label

  monocle_umap_out <- data.frame(
    cell = monocle_umap$cell,
    UMAP_1 = monocle_umap$UMAP_1,
    UMAP_2 = monocle_umap$UMAP_2,
    simulation = monocle_umap$simulation,
    stringsAsFactors = FALSE
  )

  monocle_markers <- top_markers(
    cds,
    group_cells_by = "cluster",
    reference_cells = min(1000, ncol(cds)),
    cores = 1
  )

  monocle_markers$simulation <- sim_label

  safe_write_csv(
    monocle_clusters,
    file.path(outdir, paste0("monocle3_clusters_", sim_label, ".csv"))
  )

  safe_write_csv(
    monocle_umap_out,
    file.path(outdir, paste0("monocle3_umap_", sim_label, ".csv"))
  )

  safe_write_csv(
    monocle_markers,
    file.path(outdir, paste0("monocle3_markers_", sim_label, ".csv"))
  )

  saveRDS(
    cds,
    file.path(outdir, paste0("monocle3_cds_", sim_label, ".rds"))
  )

  cat("Monocle3 workflow finished.\n")

} else {

  cat("\nMonocle3 workflow skipped because run_monocle3 <- FALSE.\n")

  monocle_clusters <- NULL
  monocle_umap_out <- NULL
  monocle_markers <- NULL
}


